# ---------------------------------------------------------------------------
# DEVELOPMENT — your own machine. Copy to `.env.development`.
#
#   cp .env.development.example .env.development
#
# This is the only environment where debugging conveniences are allowed: OTPs
# are printed to the console, and error responses include stack traces.
# ---------------------------------------------------------------------------

APP_ENV=development

PORT=3001
LOG_LEVEL=debug

# Use a database that is clearly not production. A local mongod is ideal; if you
# use the shared Atlas cluster, make sure the database name ends in -dev.
MONGODB_URI=mongodb://localhost:27017/fossil-procure-dev

# Generate your own: openssl rand -base64 48
JWT_SECRET=

JWT_EXPIRES_IN=7d

# The login OTP is returned by the API and filled into the form automatically,
# so you never wait on email locally. Set to 'false' if you want to exercise the
# real two-step flow. Production ignores this setting entirely.
OTP_EXPOSE_IN_RESPONSE=true

# Optional locally: without a key, OTPs still appear in the server console.
RESEND_API_KEY=
EMAIL_FROM=Tefoma Procurement (dev) <notifications@miccstechnologies.co.zw>

COMPANY_NAME=Tefoma Construction
PRODUCT_NAME=Tefoma Procurement (dev)

CLIENT_URL=http://localhost:5173

# Alert jobs run on a timer. Turn them off locally so you are not sending mail
# on every restart.
ALERT_JOBS_ENABLED=false
ALERT_JOBS_INTERVAL_MS=3600000
ALERT_DEDUP_HOURS=24
RFQ_DEADLINE_ALERT_HOURS=48
LOW_STOCK_DEFAULT_THRESHOLD=5
