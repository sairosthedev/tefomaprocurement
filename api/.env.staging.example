# ---------------------------------------------------------------------------
# STAGING — a deployed, shared environment that mirrors production.
#
# On Vercel these are set in the `tefomaprocurement-api-staging` project's
# environment variables, not in a file. This template is the checklist for what
# that project needs.
#
# Staging is reachable by other people, so it behaves like production: no OTPs
# in logs or responses, no stack traces to callers. The only differences are the
# database, the URLs, and the fact that its data is disposable.
# ---------------------------------------------------------------------------

APP_ENV=staging

PORT=3001
LOG_LEVEL=info

# MUST be a separate database from production. Test runs here wipe and reseed.
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/fossil-procure-staging

# MUST differ from the production secret — a leaked staging key must not mint
# tokens that production will accept. openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Rejected at startup if 'true'. Staging is shared; testers use real email OTPs.
OTP_EXPOSE_IN_RESPONSE=false

# Required — no key means no OTP delivery, which means nobody can log in.
RESEND_API_KEY=
EMAIL_FROM=Tefoma Procurement (staging) <notifications@miccstechnologies.co.zw>

COMPANY_NAME=Tefoma Construction
# Keep "staging" visible in the product name so testers can tell at a glance
# which system they are looking at.
PRODUCT_NAME=Tefoma Procurement (staging)

CLIENT_URL=https://tefomaprocurement-staging.vercel.app

# CORS_ORIGINS=

ALERT_JOBS_ENABLED=true
ALERT_JOBS_INTERVAL_MS=3600000
ALERT_DEDUP_HOURS=24
RFQ_DEADLINE_ALERT_HOURS=48
LOW_STOCK_DEFAULT_THRESHOLD=5
