# ---------------------------------------------------------------------------
# Base template. Copy to .env.development, .env.staging or .env.production and
# fill in the values — or start from the matching .env.<env>.example, which has
# the correct settings for that environment already chosen.
#
# Load order (first file to define a key wins; real platform/shell variables
# always win over files):
#   .env.<APP_ENV>.local  → personal overrides, never committed
#   .env.<APP_ENV>        → this environment's settings
#   .env                  → defaults shared by every environment
# ---------------------------------------------------------------------------

# Which environment this process is. One of: development | staging | production
# The API refuses to start on any other value.
APP_ENV=development

# Server
PORT=3001
LOG_LEVEL=info

# Database. Each environment MUST use its own database — production refuses to
# start if this points at a database whose name looks like dev/staging/test.
MONGODB_URI=

# Auth
# REQUIRED. The API refuses to start without this. Must be at least 32 characters
# and must not be a placeholder. Generate one with: openssl rand -base64 48
# Use a DIFFERENT secret in each environment: a leaked staging secret must not
# mint valid production tokens.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Testing only. When 'true', the login response includes the OTP so a browser
# console can read it — this hands the second factor to the caller, so it is
# rejected at startup in staging and production. Development only.
OTP_EXPOSE_IN_RESPONSE=false

# Email (Resend). Required in staging and production: without it no OTP can be
# delivered and nobody can log in.
RESEND_API_KEY=
EMAIL_FROM=

# Branding (Tefoma)
COMPANY_NAME=Tefoma Construction
PRODUCT_NAME=Tefoma Procurement

# Front-end URL (used in email links and CORS). Required when deployed.
CLIENT_URL=http://localhost:5173

# Extra allowed browser origins (comma-separated), e.g. preview deployments
# CORS_ORIGINS=

# Scheduled alerts (low stock, RFQ deadlines)
ALERT_JOBS_ENABLED=true
ALERT_JOBS_INTERVAL_MS=3600000
ALERT_DEDUP_HOURS=24
RFQ_DEADLINE_ALERT_HOURS=48
LOW_STOCK_DEFAULT_THRESHOLD=5
