# ---------------------------------------------------------------------------
# PRODUCTION — the live system used by Tefoma.
#
# On Vercel these are set in the `tefomaprocurement-api` project's environment
# variables, not in a file. This template is the checklist for that project.
#
# Never copy this file to `.env.production` on a developer machine: it would put
# live database and email credentials on a laptop.
# ---------------------------------------------------------------------------

APP_ENV=production

PORT=3001
LOG_LEVEL=info

# The live database. Startup fails if this name contains dev/staging/test, or
# points at localhost.
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/fossil-procure

# Unique to production. Rotating this signs every user out, which is the
# intended response to a suspected leak. openssl rand -base64 48
JWT_SECRET=

JWT_EXPIRES_IN=7d

# Rejected at startup if 'true'. Production never returns the OTP to the caller;
# the code refuses regardless of this value.
OTP_EXPOSE_IN_RESPONSE=false

# Required.
RESEND_API_KEY=
EMAIL_FROM=Tefoma Procurement <notifications@miccstechnologies.co.zw>

COMPANY_NAME=Tefoma Construction
PRODUCT_NAME=Tefoma Procurement

CLIENT_URL=https://tefomaprocurement.vercel.app

# CORS_ORIGINS=

ALERT_JOBS_ENABLED=true
ALERT_JOBS_INTERVAL_MS=3600000
ALERT_DEDUP_HOURS=24
RFQ_DEADLINE_ALERT_HOURS=48
LOW_STOCK_DEFAULT_THRESHOLD=5
