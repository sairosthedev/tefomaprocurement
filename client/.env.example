# ---------------------------------------------------------------------------
# Front-end environment. Copy to `.env.development` for local work, or start
# from the matching .env.<env>.example.
#
# Vite inlines these at BUILD time, so a staging build and a production build
# are different artifacts. Only variables prefixed VITE_ reach the browser —
# and everything that does is public. Never put a secret here.
# ---------------------------------------------------------------------------

# Which deployment this bundle is: development | staging | production
# Controls the environment badge and any debugging affordances. If unset, a
# production build is treated as production.
VITE_APP_ENV=development

# API base URL — host only or full path; `/api` is appended automatically if
# missing. Must point at the API for the SAME environment.
#   development → http://localhost:3001/api
#   staging     → https://tefomaprocurement-api-staging.vercel.app
#   production  → https://tefomaprocurement-api.vercel.app
VITE_API_URL=http://localhost:3001/api
