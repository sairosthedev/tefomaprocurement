# STAGING — set these in the `tefomaprocurement-staging` Vercel project's
# environment variables. This file is the checklist for what that project needs.
#
# The API URL must be the STAGING API. Pointing a staging front-end at the
# production API is the one mistake that lets test activity reach live data.

VITE_APP_ENV=staging
VITE_API_URL=https://tefomaprocurement-api-staging.vercel.app
